{
  "name": "qrcode-factory-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "prisma generate && prisma db push --accept-data-loss && node src/server.js",
    "dev": "node --watch src/server.js",
    "postinstall": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate deploy",
    "db:test:up": "docker compose -f ../docker-compose.test.yml up -d --wait",
    "db:test:down": "docker compose -f ../docker-compose.test.yml down",
    "db:test:reset": "docker compose -f ../docker-compose.test.yml down -v && npm run db:test:up && npm run db:test:push && npm run seed:test",
    "db:test:push": "DATABASE_URL=postgresql://qrcode:devpass@localhost:5433/qrcode_factory_test prisma db push --skip-generate",
    "seed:test": "node --env-file=.env.test prisma/seed.mjs",
    "dev:test": "node --env-file=.env.test --watch src/server.js"
  },
  "dependencies": {
    "@fastify/compress": "^7.0.3",
    "@fastify/cors": "^9.0.1",
    "@fastify/helmet": "^11.1.1",
    "@fastify/jwt": "^8.0.1",
    "@fastify/rate-limit": "^9.1.0",
    "@prisma/client": "^5.22.0",
    "bcryptjs": "^2.4.3",
    "fastify": "^4.28.1"
  },
  "devDependencies": {
    "prisma": "^5.22.0"
  },
  "engines": {
    "node": ">=20"
  }
}
