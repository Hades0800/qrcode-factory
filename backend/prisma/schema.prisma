generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ───────────────────────────────
// 帳號管理
// ───────────────────────────────

model Leader {
  id           Int      @id @default(autoincrement())
  username     String   @unique
  passwordHash String
  displayName  String
  isAdmin      Boolean  @default(false)
  isPlanner    Boolean  @default(false)
  createdAt    DateTime @default(now())

  orders Order[]
}

// ───────────────────────────────
// 工單
// ───────────────────────────────

model Order {
  id        Int      @id @default(autoincrement())
  orderNo   String   @unique
  machineNo String?
  leaderId  Int?
  leader    Leader?  @relation(fields: [leaderId], references: [id])

  // 匯入欄位（生管 Excel 上傳）
  productionDate DateTime?
  productSpec    String?
  moldSpec       String?
  material       String?
  dispatchQty    Int?
  bladeCount     Int?
  machineSPM     Int?
  unitWeight     Float?
  totalWeight    Float?

  // 前置步驟（21/22/23 按鈕直接記錄）
  step21At DateTime?
  step22At DateTime?
  step23At DateTime?

  // 工序 01-07（改用 StepEntry 日誌，以下欄位為舊資料相容）
  step1At  DateTime?
  step2At  DateTime?
  step3At  DateTime?
  step4At  DateTime?
  step4Note String?  // 已棄用
  step5At  DateTime?
  step6At  DateTime?
  step7At  DateTime?
  step7Note String?  // 已棄用

  // 完成/暫停/異常
  step11At   DateTime?
  step12At   DateTime?  // 已棄用（改用 PauseEvent）
  step12Note String?    // 已棄用
  step13At   DateTime?  // 已棄用（改用 PauseEvent）
  step13Note String?    // 已棄用

  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  pauseEvents PauseEvent[]
  stepEntries StepEntry[]

  @@index([orderNo])
  @@index([productionDate])
  @@index([machineNo])
  @@index([updatedAt])
}

// ───────────────────────────────
// 工序紀錄（日誌式，可多次）
// ───────────────────────────────

model StepEntry {
  id         Int      @id @default(autoincrement())
  orderId    Int
  order      Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  stepNo     String   // "1"~"7", "21"~"23", "12", "13"
  seq        Int      // 第幾次
  recordedAt DateTime @default(now())
  isManual   Boolean  @default(false) // 補登
  leaderId   Int?
  leaderName String?

  @@index([orderId])
  @@index([orderId, stepNo])
}

// ───────────────────────────────
// 暫停 / 異常事件（開關式計時）
// ───────────────────────────────

model PauseEvent {
  id         Int       @id @default(autoincrement())
  orderId    Int
  order      Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  type       String    // "12" = 正常暫停, "13" = 異常停止
  activeStep String?
  startAt    DateTime  @default(now())
  endAt      DateTime?
  duration   Int?
  note       String?

  @@index([orderId])
}

// ───────────────────────────────
// 上傳批次追蹤
// ───────────────────────────────

model UploadBatch {
  id             Int         @id @default(autoincrement())
  filename       String
  uploadedBy     Int?
  uploadedByName String?
  rowCount       Int
  productionDate DateTime?
  orderNos       String[]
  uploadedAt     DateTime    @default(now())
  cancelledAt    DateTime?
  rows           UploadRow[]

  @@index([uploadedAt])
}

// 原始上傳資料（每一列 Excel 原封不動保存）
model UploadRow {
  id            Int         @id @default(autoincrement())
  batchId       Int
  batch         UploadBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  orderNo       String
  productSpec   String?
  moldSpec      String?
  material      String?
  machineNo     String?
  dispatchQty   Int?
  bladeCount    Int?
  machineSPM    Int?
  unitWeight    Float?
  totalWeight   Float?
  // 處理結果
  status        String      @default("created") // created, updated, skipped, error
  errorMsg      String?

  @@index([batchId])
  @@index([orderNo])
}

// ───────────────────────────────
// 無工令事件（機台閒置紀錄）
// ───────────────────────────────

model IdleEvent {
  id         Int      @id @default(autoincrement())
  machineNo  String
  leaderId   Int?
  leaderName String?
  note       String?
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([machineNo])
}

// ───────────────────────────────
// 稽核日誌
// ───────────────────────────────

model AuditLog {
  id        Int      @id @default(autoincrement())
  actorId   Int?
  actorName String?
  action    String
  target    String?
  detail    String?
  ip        String?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([actorId])
  @@index([action])
}
