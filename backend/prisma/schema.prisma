generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Leader {
  id           Int      @id @default(autoincrement())
  username     String   @unique
  passwordHash String
  displayName  String
  isAdmin      Boolean  @default(false)
  isPlanner    Boolean  @default(false)
  createdAt    DateTime @default(now())

  orders Order[]
}

model Order {
  id        Int      @id @default(autoincrement())
  orderNo   String   @unique
  machineNo String?
  leaderId  Int?
  leader    Leader?  @relation(fields: [leaderId], references: [id])

  // 匯入欄位（生管上傳）
  productionDate DateTime?  // 生產日期
  productSpec    String?     // 生產規格
  moldSpec       String?     // 模具規格
  material       String?     // 領用材料
  dispatchQty    Int?        // 派工數
  bladeCount     Int?        // 刀數
  machineSPM     Int?        // 機器SPM
  unitWeight     Float?      // 一片理論重(kg)
  totalWeight    Float?      // 全部總重量(kg)

  step21At  DateTime?  // 設備啓動準備
  step22At  DateTime?  // 生產準備完成
  step23At  DateTime?  // 生產無工令

  step1At   DateTime?
  step2At   DateTime?
  step3At   DateTime?
  step4At   DateTime?
  step4Note String?
  step5At   DateTime?
  step6At   DateTime?
  step7At   DateTime?
  step7Note String?

  step11At   DateTime?
  step12At   DateTime?
  step12Note String?
  step13At   DateTime?
  step13Note String?

  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  pauseEvents PauseEvent[]

  @@index([orderNo])
  @@index([productionDate])
  @@index([machineNo])
  @@index([updatedAt])
}

model AuditLog {
  id        Int      @id @default(autoincrement())
  actorId   Int?
  actorName String?
  action    String   // e.g. "delete_order", "cancel_batch", "reset_password"
  target    String?  // e.g. orderNo / batchId / leaderUsername
  detail    String?  // 可選：原因 / 額外資訊
  ip        String?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([actorId])
  @@index([action])
}

model UploadBatch {
  id             Int       @id @default(autoincrement())
  filename       String
  uploadedBy     Int?
  uploadedByName String?
  rowCount       Int
  productionDate DateTime?
  orderNos       String[]
  uploadedAt     DateTime  @default(now())
  cancelledAt    DateTime?

  @@index([uploadedAt])
}

model IdleEvent {
  id         Int      @id @default(autoincrement())
  machineNo  String
  leaderId   Int?
  leaderName String?
  note       String?
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([machineNo])
}

model PauseEvent {
  id         Int       @id @default(autoincrement())
  orderId    Int
  order      Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  type       String    // "12" = 正常暫停, "13" = 異常停止
  activeStep String?
  startAt    DateTime  @default(now())
  endAt      DateTime?
  duration   Int?
  note       String?

  @@index([orderId])
}
