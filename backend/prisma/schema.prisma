generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Leader {
  id           Int      @id @default(autoincrement())
  username     String   @unique
  passwordHash String
  displayName  String
  isAdmin      Boolean  @default(false)
  createdAt    DateTime @default(now())

  orders Order[]
}

model Order {
  id        Int      @id @default(autoincrement())
  orderNo   String   @unique
  machineNo String?
  leaderId  Int?
  leader    Leader?  @relation(fields: [leaderId], references: [id])

  step1At   DateTime?
  step2At   DateTime?
  step3At   DateTime?
  step4At   DateTime?
  step4Note String?
  step5At   DateTime?
  step6At   DateTime?
  step7At   DateTime?
  step7Note String?

  step11At   DateTime?
  step12At   DateTime?
  step12Note String?
  step13At   DateTime?
  step13Note String?

  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  pauseEvents PauseEvent[]

  @@index([orderNo])
}

model PauseEvent {
  id         Int       @id @default(autoincrement())
  orderId    Int
  order      Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  type       String    // "12" = 正常暫停, "13" = 異常停止
  activeStep String?   // 暫停當下的工序（例如 "04. 斷續試稼生產製造"）
  startAt    DateTime  @default(now())
  endAt      DateTime?
  duration   Int?      // 秒數（endAt - startAt）
  note       String?
}
