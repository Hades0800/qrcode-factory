generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// 模組切分(對照 docs/MODULES.md 與「QR Code MES 關聯表」的簡易關聯圖):
//   共用層      Leader、AuditLog
//   入出庫      Label、LabelSpec、Location、StockMove          ← 標籤在這裡,四個系統共用
//   生產 MES    Order、EquipmentParam、StepEntry、PauseEvent、UploadBatch、UploadRow、IdleEvent
//   裁切 MES    ProcessOrder、ProcessEntry
//   出貨管理    Shipment、ShipmentItem
// 同一個資料庫,靠標籤(Label)把四個系統串起來;各模組只寫自己的表,跨模組一律經由 Label。

// ───────────────────────────────
// 共用層:帳號管理
// ───────────────────────────────

model Leader {
  id           Int       @id @default(autoincrement())
  username     String    @unique
  passwordHash String
  displayName  String
  isAdmin      Boolean   @default(false)
  isPlanner    Boolean   @default(false)
  roles        String?   // 角色,逗號字串:sales / warehouse / planner / production / processing(見 lib/roles.js)
  createdAt    DateTime  @default(now())
  deletedAt    DateTime?

  orders Order[]

  @@index([deletedAt])
}

// ───────────────────────────────
// 工單
// ───────────────────────────────

model Order {
  id                Int      @id @default(autoincrement())
  orderNo           String   @unique
  machineNo         String?
  plannedMachineNo  String?  // 上傳時 Excel 排定的機台（現場實際紀錄機台以 machineNo 為準，兩者不同時代表現場跳機台）
  leaderId          Int?
  leader            Leader?  @relation(fields: [leaderId], references: [id])
  // 對照 QR 標籤(入出庫模組):同一張製造單可能貼多張標籤(多規格),這裡記最後產生的那張
  labelId           Int?
  label             Label?   @relation(fields: [labelId], references: [id])
  poNo              String?  // 訂單編號(客戶 PO;標籤第 2 項)
  dueDate           DateTime? // 交貨 / 納期(週排程表的交貨日期;標籤第 5 項)
  remark            String?  // 備註說明(例:需委外鍍鋅與整平;標籤第 5 項)

  // 匯入欄位（生管 Excel 上傳）
  productionDate DateTime?  // 已棄用：保留兼容，新邏輯改用 plannedDate / actualStartDate
  plannedDate    DateTime?  // 計畫日期：Excel 上傳的日期，可被新上傳覆寫（生管的計畫）
  planSeq        Int?       // 計畫序號：上傳 Excel 的列順序（同一天內用它排序，還原生管排定順序）；每次上傳覆寫
  actualStartDate DateTime? // 實際開始日期：第一筆 stepEntry/pauseEvent 的台灣日期，永久鎖定（現場事實）
  // 規格類型（現場技術員選擇）
  specType         String?  // 'new' = 新製規格、'mass' = 量產規格
  difficultyFactor Float?   // 新製規格的難易權重係數（1.1 / 1.2 / 1.3 / 1.4 / 1.5 / 1.6）→ 生產時間 = 理論時間 × 係數
  newSpecAspects   String?  // 新製規格的差異項目，逗號字串：raw=原料 / mold=模具 / dim=長寬，例：'raw,mold'
  changeScope      String?  // '@' = 僅換原料 / '#' = 僅換模刀具 / '@#' = 兩者都換
  materialType     String?  // 'coil' = 捲料（係數 1.0）/ 'plate' = 板料（係數 1.2）
  auxEquipment       String?  // 輔助設備：逗號字串（flat/leveler/slitter/wave/rewind/other 可多選）
  auxEquipmentCustom String?  // 輔助設備自訂名稱（使用者自填）
  auxEquipmentNos    String?  // 各輔助設備的編號（JSON 字串，代碼→編號，例：{"leveler":"A12"}）
  operatorName       String?  // 設備操作人員姓名（第五步）
  totalWorkers       Int?     // 全部作業人數（第五步）
  productSpec    String?
  manuSpec       String?  // 製造規格（生管 Excel 上傳；與 SPM/刀數同層的規格欄）
  customerName   String?  // 客戶名稱（生管 Excel 上傳）
  moldSpec       String?
  material       String?
  dispatchQty    Int?
  bladeCount     Int?
  machineSPM     Int?
  unitWeight     Float?
  totalWeight    Float?

  // 前置步驟（21/22/23 按鈕直接記錄）
  step21At DateTime?
  step22At DateTime?
  step23At DateTime?

  // 工序 01-07（改用 StepEntry 日誌，以下欄位為舊資料相容）
  step1At  DateTime?
  step2At  DateTime?
  step3At  DateTime?
  step4At  DateTime?
  step4Note String?  // 已棄用
  step5At  DateTime?
  step6At  DateTime?
  step7At  DateTime?
  step7Note String?  // 已棄用

  // 完成/暫停/異常
  step11At   DateTime?
  step11Note String?    // 完成備註：含附屬設備 / 不含附屬設備
  step11QcActualQty Int?     // QC 實際生產數量（完成時填）：單一規格=工單總量；多規格=最後一段規格的量
  step12At   DateTime?  // 已棄用（改用 PauseEvent）
  step12Note String?    // 已棄用
  step13At   DateTime?  // 已棄用（改用 PauseEvent）
  step13Note String?    // 已棄用

  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  deletedAt   DateTime?
  pauseEvents PauseEvent[]
  stepEntries StepEntry[]
  equipmentParam EquipmentParam?

  @@index([orderNo])
  @@index([productionDate])
  @@index([plannedDate])
  @@index([actualStartDate])
  @@index([machineNo])
  @@index([updatedAt])
  @@index([deletedAt])
}

// ───────────────────────────────
// 設備參數（一般人員上傳；一張工單一筆）
// ───────────────────────────────

model EquipmentParam {
  id              Int       @id @default(autoincrement())
  orderId         Int       @unique
  order           Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderNo         String    // 冗餘欄方便查詢

  operation        String?  // 設備操作
  totalWorkers     Int?     // 全部作業人數
  paramFileName    String?  // 設備參數檔名
  paramFileAttr    String?  // 參數檔案屬性
  productSpecAttr  String?  // 生產規格屬性

  // 參數值（實際使用值）
  moldSpec         String?  // 模具規格
  machineSPM       Float?   // 機器SPM
  bladeCount       Int?     // 生產刀數
  feedSetting      String?  // 送料設定
  cutterStroke     String?  // 大刀座行程
  strokeUpdateFreq String?  // 行程更新頻度

  // 基礎參數（標準/基準值）
  baseProductSpecAttr  String?
  baseParamFileName    String?
  baseParamFileAttr    String?
  baseMoldSpec         String?
  baseMachineSPM       Float?
  baseBladeCount       Int?
  baseFeedSetting      String?
  baseCutterStroke     String?
  baseStrokeUpdateFreq String?

  // 多規格：每個生產規格各自的 SPM / 刀數（JSON 陣列 [{spec,spm,blades}]）
  // specRows = 原始參數；baseSpecRows = 製造參數。優先於上面單一的 machineSPM/bladeCount/productSpecAttr
  specRows         String?
  baseSpecRows     String?

  createdBy        Int?
  createdByName    String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  deletedAt        DateTime?

  @@index([orderNo])
  @@index([deletedAt])
}

// ───────────────────────────────
// 工序紀錄（日誌式，可多次）
// ───────────────────────────────

model StepEntry {
  id         Int       @id @default(autoincrement())
  orderId    Int
  order      Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  stepNo     String    // "1"~"7", "21"~"23", "12", "13", "30"(更換規格)
  seq        Int       // 第幾次
  recordedAt DateTime  @default(now())
  isManual   Boolean   @default(false) // 補登
  note       String?   // stepNo="30" 時存規格描述
  qcActualQty Int?     // QC 實際生產數量：stepNo="30"（前一段規格的量）才會有
  leaderId   Int?
  leaderName String?
  deletedAt  DateTime?

  @@index([orderId])
  @@index([orderId, stepNo])
  @@index([deletedAt])
}

// ───────────────────────────────
// 暫停 / 異常事件（開關式計時）
// ───────────────────────────────

model PauseEvent {
  id         Int       @id @default(autoincrement())
  orderId    Int
  order      Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  type       String    // "12" = 正常暫停, "13" = 異常停止
  activeStep String?
  startAt    DateTime  @default(now())
  endAt      DateTime?
  duration   Int?
  note       String?
  qcActualQty Int?     // QC 實際生產數量：type="12" 且 note 含「下班」（隔日生產）才會有
  interruptedByOrderNo String?  // 插單暫停（note="插單暫停"）：被哪張工單插單
  deletedAt  DateTime?

  @@index([orderId])
  @@index([deletedAt])
}

// ───────────────────────────────
// 上傳批次追蹤
// ───────────────────────────────

model UploadBatch {
  id             Int         @id @default(autoincrement())
  filename       String
  uploadedBy     Int?
  uploadedByName String?
  rowCount       Int
  productionDate DateTime?
  orderNos       String[]
  uploadedAt     DateTime    @default(now())
  cancelledAt    DateTime?
  rows           UploadRow[]

  @@index([uploadedAt])
}

// 原始上傳資料（每一列 Excel 原封不動保存）
model UploadRow {
  id            Int         @id @default(autoincrement())
  batchId       Int
  batch         UploadBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  orderNo       String
  productSpec   String?
  manuSpec      String?  // 製造規格（生管 Excel 上傳）
  customerName  String?
  moldSpec      String?
  material      String?
  machineNo     String?
  dispatchQty   Int?
  bladeCount    Int?
  machineSPM    Int?
  unitWeight    Float?
  totalWeight   Float?
  // 處理結果
  status        String      @default("created") // created, updated, skipped, error
  errorMsg      String?

  @@index([batchId])
  @@index([orderNo])
}

// ───────────────────────────────
// 無工令事件（機台閒置紀錄）
// ───────────────────────────────

model IdleEvent {
  id         Int       @id @default(autoincrement())
  machineNo  String
  leaderId   Int?
  leaderName String?
  note       String?
  createdAt  DateTime  @default(now())
  deletedAt  DateTime?

  @@index([createdAt])
  @@index([machineNo])
  @@index([deletedAt])
}

// ───────────────────────────────
// 稽核日誌
// ───────────────────────────────

model AuditLog {
  id        Int      @id @default(autoincrement())
  actorId   Int?
  actorName String?
  action    String
  target    String?
  detail    String?
  ip        String?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([actorId])
  @@index([action])
}

// ═══════════════════════════════════════════════
// 入出庫模組:QR 標籤(四個系統共用的載體)
// ═══════════════════════════════════════════════

// 一張標籤 = 一個 QR。QR 內容是「範例一~三」定義的六項文字(每項一行),見 modules/inventory/domain/label.js:
//   1 客戶/廠商  2 訂單編號  3 製造單號[ , 加工單號]  4 倉庫儲位[ , 機台編號]
//   5 製造/納期[ , 備註]      6.. 每一條規格:規格 , 數量 , 重量(多規格就多行)
// 沒有的項目填「-」(範例三的原料標籤)。掃到 QR 之後用 parseQrText 還原欄位,再對回這張表。
model Label {
  id             Int       @id @default(autoincrement())
  code           String    @unique   // 標籤碼(LB + 日期 + 流水),印在標籤角落當備援,不進 QR
  kind           String              // material 原料 / semi 半成品 / finished 成品 / outsourced 委外加工
  customer       String?
  poNo           String?
  manuOrderNo    String?             // 製造單號 F…(生產 MES 的 Order.orderNo)
  processOrderNo String?             // 加工單號 G…(裁切 MES 的 ProcessOrder.processNo)
  location       String?             // 倉庫儲位
  machineNo      String?
  dueDate        DateTime?
  remark         String?
  qrText         String              // 六項文字,每項一行;產 QR 圖就用這段
  status         String    @default("active") // active / closed(裁切結案) / shipped(已出貨)
  createdBy      Int?
  createdByName  String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  specs         LabelSpec[]
  moves         StockMove[]
  orders        Order[]
  processOrders ProcessOrder[]
  shipmentItems ShipmentItem[]

  @@index([manuOrderNo])
  @@index([processOrderNo])
  @@index([kind])
  @@index([status])
  @@index([deletedAt])
}

// 標籤上的規格列(範例二一張標籤 7 條規格)
model LabelSpec {
  id      Int    @id @default(autoincrement())
  labelId Int
  label   Label  @relation(fields: [labelId], references: [id], onDelete: Cascade)
  seq     Int
  spec    String
  qty     Int?
  weight  Float?

  @@index([labelId])
}

// 倉庫儲位(D-C-F123 這種代碼)
model Location {
  id        Int       @id @default(autoincrement())
  code      String    @unique
  name      String?
  zone      String?
  createdAt DateTime  @default(now())
  deletedAt DateTime?

  @@index([deletedAt])
}

// 入庫 / 出庫紀錄(關聯表的「入庫 QR Code」「出庫 QR Code」;四個階段共用同一張表,用 stage 區分)
model StockMove {
  id        Int       @id @default(autoincrement())
  labelId   Int
  label     Label     @relation(fields: [labelId], references: [id], onDelete: Cascade)
  type      String    // in 入庫 / out 出庫
  stage     String    // material 原料 / semi 生產-半成品 / finished 生產或庫存-成品 / outsourced 委外/加工/包裝/整修
  location  String?   // 入庫放哪、出庫從哪
  qty       Int?
  weight    Float?
  refType   String?   // 誰引起的:order 製造單 / process 加工單 / shipment 出貨單 / manual 手動
  refNo     String?
  note      String?
  actorId   Int?
  actorName String?
  at        DateTime  @default(now())
  deletedAt DateTime?

  @@index([labelId])
  @@index([at])
  @@index([refType, refNo])
  @@index([deletedAt])
}

// ═══════════════════════════════════════════════
// 裁切 MES 模組:加工單(G 號),綁定製造單(F 號)
// ═══════════════════════════════════════════════

model ProcessOrder {
  id              Int       @id @default(autoincrement())
  processNo       String    @unique   // 加工單號 G…
  workOrderNo     String?             // 工令單號 E…:製造單與加工單掛在同一個工令底下
  manuOrderNo     String?             // 對應的製造單號 F…(沒有對應製造單時為空,計畫表顯示 ------)
  labelId         Int?
  label           Label?    @relation(fields: [labelId], references: [id])
  customer        String?
  spec            String?             // 裁切規格(多條用換行)
  qty             Int?
  weight          Float?
  machineNo       String?             // 操作機台:生管指派(31 / 32 / 33)
  seqNo           Int?                // 生產順序:同機台同日的排序,生管排單時決定
  layoutFile      String?             // 加工配置圖(SKCutTool 輸出),計畫表上點「開啟」看的就是它
  // 四個日期分屬不同人,不要混用
  dispatchDate    DateTime?           // 派工日期:業務助理(ERP 帶出)
  dueDate         DateTime?           // 交貨日期:業務助理(ERP 帶出)
  plannedDate     DateTime?           // 預計日期:生管排單時填
  finishDate      DateTime?           // 完工日期:生管填(與系統結案時間 completedAt 不同)
  remark          String?
  status          String    @default("open")  // open / done(QR Code 結案)
  completedAt     DateTime?
  completedQty    Int?
  completedWeight Float?
  createdBy       Int?
  createdByName   String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?

  // 生管在 MES 填（QRP 上這幾欄是空白的，印出來才手寫）
  preparerName    String?             // 備料人員
  operatorName    String?             // 操作員
  // 現場填(對照「裁切加工計畫表」畫面)
  oddCutting      Boolean   @default(false)  // 零星裁剪:現場依狀況決定
  waitingMaterial Boolean   @default(false)  // 等待材料
  startedAt       DateTime?           // 開始時間:現場點一下記錄
  finishedAt      DateTime?           // 完成時間:現場點一下記錄
  totalWorkers    Int?                // 作業總人數
  storageLocation String?             // 入庫儲位
  // ERP 帶的（這張加工單若由製造單產生，ERP 會自動帶出）
  poNo            String?             // 訂單號碼
  productModel    String?             // 產品型號
  // Excel 排單檔帶的
  customerCode    String?             // 公司編號(含代號),例 26-33610003 台鎰
  area            String?             // 區域:北區/中區/南區
  category        String?             // 類別:擴張網/編織網
  returnedQty     Int?                // 已回數量(ERP 回單進度,重傳 Excel 可同步)
  pendingQty      Int?                // 未回數量
  erpClosed       Boolean   @default(false)  // ERP 結案
  // 這張單的資料分別從哪來(qrp / excel / manual,逗號字串)
  sources         String?

  entries ProcessEntry[]
  items   ProcessOrderItem[]

  @@index([workOrderNo])
  @@index([manuOrderNo])
  @@index([status])
  @@index([machineNo, plannedDate, seqNo])   // 計畫表:選機台 + 日期,依生產順序列出
  @@index([plannedDate])
  @@index([dispatchDate])
  @@index([dueDate])
  @@index([deletedAt])
}

// 加工單明細。一張加工單可以有多個項次,數量各自不同
// (實例:G1150811002 有 11 個項次)。原本只用 ProcessOrder.spec 一個文字欄存不下。
model ProcessOrderItem {
  id             Int          @id @default(autoincrement())
  processOrderId Int
  processOrder   ProcessOrder @relation(fields: [processOrderId], references: [id], onDelete: Cascade)
  seq            String       // 項次:0010 / 0020 …
  spec           String       // 品名規格
  qty            Int?
  unit           String?      // PCS / 捲
  unitWeight     Float?       // 單重
  totalWeight    Float?       // 總數(重量)
  modelCode      String?      // 型號代碼
  materialCode   String?      // 材質編號:鋁 / SUS304 …
  kind           String       @default("item") // item 品項 / note 備註(QRP 會把公差、包裝要求也印成明細行)
  returnedQty    Int?         // 該項次已回數量
  pendingQty     Int?
  source         String?      // qrp / excel / manual
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  deletedAt      DateTime?

  @@unique([processOrderId, seq, spec])
  @@index([processOrderId])
  @@index([deletedAt])
}

// 裁切工序紀錄(日誌式,跟生產 MES 的 StepEntry 同一套想法)
model ProcessEntry {
  id             Int          @id @default(autoincrement())
  processOrderId Int
  processOrder   ProcessOrder @relation(fields: [processOrderId], references: [id], onDelete: Cascade)
  stepNo         String       // 1 領料 / 2 裁切開始 / 3 裁切完成 / 4 包裝 / 9 其他
  note           String?
  recordedAt     DateTime     @default(now())
  leaderId       Int?
  leaderName     String?
  deletedAt      DateTime?

  @@index([processOrderId])
  @@index([deletedAt])
}

// ═══════════════════════════════════════════════
// 出貨管理模組:出貨單
// ═══════════════════════════════════════════════

model Shipment {
  id            Int       @id @default(autoincrement())
  shipNo        String    @unique
  customer      String?
  shipDate      DateTime?
  status        String    @default("open")  // open / checked(倉管 QR 檢核完) / shipped(已出庫)
  note          String?
  createdBy     Int?
  createdByName String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?

  items ShipmentItem[]

  @@index([status])
  @@index([shipDate])
  @@index([deletedAt])
}

// 出貨單明細:掃「庫存 QR」(成品標籤)或「零購 QR」(零售/零購,可能沒有標籤)加入
model ShipmentItem {
  id            Int       @id @default(autoincrement())
  shipmentId    Int
  shipment      Shipment  @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  labelId       Int?
  label         Label?    @relation(fields: [labelId], references: [id])
  source        String    // stock 庫存 QR / retail 零購 QR
  spec          String?
  qty           Int?
  weight        Float?
  checkedAt     DateTime? // 倉管 QR 檢核時間
  checkedByName String?
  deletedAt     DateTime?

  @@index([shipmentId])
  @@index([labelId])
  @@index([deletedAt])
}
